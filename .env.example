# AWS Cognito Configuration
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_IDENTITY_POOL_ID=

# Cognito OAuth Configuration
# NEXT_PUBLIC_COGNITO_DOMAIN: Cognito Hosted UI domain (e.g., your-app.auth.ap-northeast-1.amazoncognito.com)
NEXT_PUBLIC_COGNITO_DOMAIN=
# NEXT_PUBLIC_OAUTH_REDIRECT_SIGNIN: OAuth sign-in redirect URI
# - Local: http://localhost:3000/login
# - Vercel: https://your-app.vercel.app/login
NEXT_PUBLIC_OAUTH_REDIRECT_SIGNIN=
# NEXT_PUBLIC_OAUTH_REDIRECT_SIGNOUT: OAuth sign-out redirect URI
# - Local: http://localhost:3000/login
# - Vercel: https://your-app.vercel.app/login
NEXT_PUBLIC_OAUTH_REDIRECT_SIGNOUT=

# AWS Region
AWS_REGION=

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Workers API
# Note: CLOUDFLARE_WORKERS_API_TOKEN should match the API_KEY secret set in Cloudflare Workers
# Generate with: openssl rand -base64 32
CLOUDFLARE_WORKERS_API_URL=
CLOUDFLARE_WORKERS_API_TOKEN=

# Cloudflare Workers API (Split Architecture)
# 各Workerの個別URL。未設定時はCLOUDFLARE_WORKERS_API_URLにフォールバック
CLOUDFLARE_UPLOAD_API_URL=
CLOUDFLARE_LIST_API_URL=
CLOUDFLARE_DELETE_API_URL=

# Cloudflare Account (for Terraform and API management)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare D1 Database
D1_DATABASE_ID=
D1_DATABASE_NAME=

# Cloudflare R2 Photo Storage
R2_PHOTO_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Google Map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Upstash Redis (Rate Limiting)
# Used for rate limiting (10 requests per minute per user)
# Setup: Upstash Integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=