{
  "name": "learn-auth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx scripts/dev-with-logging.ts",
    "dev:no-logs": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "npm run test:cloudflare && npm run test:storybook",
    "test:cloudflare": "cd infra-cloudflare/memory-traces-api && npm test",
    "test:storybook": "test-storybook --no-index-json || echo 'Storybook tests not configured'",
    "test:a11y": "tsx scripts/test-a11y.ts",
    "test:e2e": "npx playwright test",
    "test:e2e-agent": "npx @playwright/cli",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "quality-check": "npm run type-check && npm run lint && npm run test",
    "quality-fix": "npm run lint:fix && npm run format",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "tf:fmt": "cd infra-aws && terraform fmt -recursive",
    "tf:validate": "cd infra-aws && terraform validate",
    "tf:check": "npm run tf:fmt && npm run tf:validate",
    "verify": "npm run quality-check && npm run build",
    "monitor:changelog": "tsx .github/scripts/monitor-claude-changelog.ts",
    "monitor:changelog:dry": "cross-env DRY_RUN=true tsx .github/scripts/monitor-claude-changelog.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "chromatic": "npx chromatic"
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.7.3",
    "@aws-amplify/ui-react": "^6.15.4",
    "@aws-sdk/client-lambda": "^3.1067.0",
    "@aws-sdk/credential-providers": "^3.1056.0",
    "@daypicker/react": "^10.0.1",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@upstash/redis": "^1.38.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "aws-amplify": "^6.18.0",
    "browser-image-compression": "^2.0.2",
    "capnweb": "^0.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exifr": "^7.1.3",
    "exifreader": "^4.41.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "piexifjs": "^1.0.6",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-dropzone": "^15.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@axe-core/playwright": "^4.11.3",
    "@chromatic-com/storybook": "^5.2.1",
    "@next/eslint-plugin-next": "^16.2.7",
    "@octokit/rest": "^22.0.1",
    "@playwright/cli": "^0.1.14",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-onboarding": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.4",
    "@storybook/nextjs-vite": "^10.4.4",
    "@storybook/react": "10.4.4",
    "@tailwindcss/postcss": "^4",
    "@types/diff": "^8.0.0",
    "@types/google.maps": "^3.65.0",
    "@types/node": "^25",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "chromatic": "^17.3.0",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "eslint": "^10.4.1",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.4.4",
    "husky": "^9.0.11",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "storybook": "10.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^6",
    "vite": "^8.0.14",
    "vitest": "4.1.8",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "@xstate/react": {
      "react": "19.2.4",
      "react-dom": "19.2.4"
    },
    "fast-xml-parser": "5.7.2",
    "fast-uri": "3.1.2",
    "postcss": "8.5.14",
    "flatted": "3.4.2",
    "minimatch": "10.2.3"
  }
}
